{
  "name": "dsh-shells",
  "version": "0.1.0",
  "description": "Persistent cross-platform background shells for the DeepSeek Harness agent: bash/zsh on POSIX, cmd/gitbash/pwsh on Windows, with a sidebar panel to watch the PTY streams.",
  "type": "module",
  "main": "src/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "remote",
        "sidebarRight",
        "sidebarRightTabs"
      ]
    }
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "terminal",
    "shell"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tool-terminal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-terminal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-terminal-bash": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "license": "MIT"
}
